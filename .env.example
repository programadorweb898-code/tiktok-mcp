# Optional local data/profile directory (default: ~/.tiktok-mcp).
TIKTOK_MCP_DATA_DIR=

# Optional Chrome, Edge, or Brave executable. The MCP auto-detects common paths.
TIKTOK_BROWSER_PATH=

# Optional. Desktop sessions are headed by default.
TIKTOK_HEADLESS=false

# Free ephemeral QR hand-off used by tiktok_connect (no cookies or account data).
TIKTOK_CONNECT_RELAY_URL=https://tiktok.palmyr.ai

# --- Telegram integration (optional) ---

# Bot token from @BotFather. Required to run the Telegram orchestrator
# (--telegram-bot) or to use the telegram_send MCP tool.
TELEGRAM_BOT_TOKEN=

# Default target chat id for telegram_send. The orchestrator uses it (or
# TELEGRAM_ALLOWED_CHATS) to authorize a single chat or comma-separated list.
# If omitted, the orchestrator accepts messages from any chat.
TELEGRAM_CHAT_ID=

# Comma-separated list of numeric chat ids allowed to command the orchestrator.
# Overrides TELEGRAM_CHAT_ID when both are set.
#TELEGRAM_ALLOWED_CHATS=

# LLM used by the orchestrator to reason about Telegram instructions.
# Required when running --telegram-bot.
#OPENAI_API_KEY=
#OPENAI_BASE_URL=
#TELEGRAM_BOT_MODEL=gpt-4o-mini
